{
  "name": "finbank-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Playwright end-to-end and API tests for the FinBank demo app",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:oracle": "playwright-oracle-reporter open"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "playwright-oracle-reporter": "^1.1.13"
  }
}
